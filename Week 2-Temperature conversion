//temperature conversion
#include<stdio.h>
int main()
{
  float c,f;
  //celsius to fahrenheit
  printf("Enter the temperature in celsius ");
  scanf("%f",&c);
  f=c*(9/5)+32;
  printf("\nTemperature %f in celsius is %f in fahrenheit",c,f);
  
  //farenheit to celsius 
  printf("\nEnter thr temperature in farenheit ");
  scanf("%f",f);
  c=(f-32)*5/9;
  printf("\nTemperature %f in farenheit is %f in celsius",f,c);
}