//Household Electricity bill 
#include<stdio.h>
int main()
{
  int n;
  float bill;
  printf("Enter the number of units consumed");
  scanf("%d",&n);
  if(n<=100)
  bill=(float)1.50*n;
  else if(n>100 && n<=200)
  bill=(float)2.50*n;
  else if(n>200 && n<=500)
  bill=(float)4.00*n;
  else 
  bill=(float)6.00*n;
  printf("\nThe amount of the bill is %f",bill);
}