//Finding roots of thr Quadratic Equation 
#include<stdio.h>
#include<math.h>
int main()
{
  int a,b,c,x1,x2,D;
  printf("Enter a,b and c values");
  printf("\nWhere the Quadratic equation is of the form ax²+bx+c=0");
  scanf("%d%d%d",&a,&b,&c);
  D=(b*b)-(4*a*c);
  if(D>0)
  {
    printf("\nThe roots of the equation are real and distinct");
    x1=(-b+sqrt(D))/(2*a);
    x2=(-b-sqrt(D))/(2*a);
    printf("\nThe roots of the equation are %d and %d",x1,x2);
  }
  else if(D==0)
  {
    printf("\nThe roots of the eqation are real and equal");
    x1=-b/(2*a);
    x2=-b/(2*a);
    printf("\nThe roots of the equation are %d and %d",x1,x2);
  }
  else
  {
    printf("\nThe Roots of the equation are imaginary");
    float real=(-b/(2*a));
    float ima=(sqrt(-D)/(2*a));
    printf("\nx1=%f+%f",real, ima);
    printf("\nx2=%f-%f",real,ima);
  }
}