//Arithmetic Operations
#include<stdio.h>
int main()
{
  int n,a,b;
  printf("Enter the option");
  printf("Where\n1.Addition\n2.Subtraction\n3.Multipilication\n4.Division");
  scanf("%d",&n);
  printf("Enter the numbers");
  scanf("%d%d",&a,&b);
  
  switch(n)
  { 
    case 1:
    {
      printf("\nAddition");
      int sum=a+b;
      printf("\nSum=%d",sum);
    }
    break;
    
    case 2:
    {
      printf("\nSubtraction");
      int diff=a-b;
      printf("\nDifference=%d",diff);
    }
    break;
    
    case 3:
    { 
      printf("\nMultiplication");
      int pro=a*b;
      printf("\nProduct=%d",pro);
    }
    break;
    
    case 4:
    {
      printf("\nDivision");
      if(b==0)
      printf("\nDivision by zero is not possible");
      else 
      {
        int quo=a/b;
        printf("\nQuotient=%d",quo);
      }
      
    }
    break;
    
    default:
    printf("\nInvalid Option");
  } 
}